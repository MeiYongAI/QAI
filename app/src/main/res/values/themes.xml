<resources>
    <style name="Theme.QQAi" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/qq_blue</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">true</item>
